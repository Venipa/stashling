<?xml version="1.0" encoding="utf-8"?>
<!-- Settings stay backed up. Secrets (own DataStore file, Keystore-sealed, so a restored copy is unreadable anyway) and the
     Room database stay out of backup and device transfer; -wal and -shm are its journal files. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="database" path="stashling.db" />
        <exclude domain="database" path="stashling.db-wal" />
        <exclude domain="database" path="stashling.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="database" path="stashling.db" />
        <exclude domain="database" path="stashling.db-wal" />
        <exclude domain="database" path="stashling.db-shm" />
    </device-transfer>
</data-extraction-rules>
